# -*- mode: snippet -*-
# name: frac
# key: //
# condition: (texmathp)
# --
\\frac{$1}{$2}$0

# name: inline-math
# key: mk
# condition: (texmathp)
# --
$$1 $0$

# name: display-math
# key: dm
# condition: (texmathp)
# --
\[$1\]$0

# name: square
# key: sq
# condition: (texmathp)
# --
\\sqrt{$1}$0

# name: superscript-square
# key: sr
# condition: (texmathp)
# --
^{2}$0

# name: superscript-cube
# key: cb
# condition: (texmathp)
# --
^{3}$0

# name: superscript-empty
# key: rd
# condition: (texmathp)
# --
^{$1}$0

# name: subscript-empty
# key: ud
# condition: (texmathp)
# --
_{$1}$0

# name: inverse
# key: invs
# condition: (texmathp)
# --
^{-1}$0

# name: partial
# key: par
# condition: (texmathp)
# --
\\partial

# name: hat
# key: hat
# condition: (texmathp)
# --
\\hat{$1}$0

# name: bar
# key: bar
# condition: (texmathp)
# --
\\bar{$1}$0

# name: vec
# key: vec
# condition: (texmathp)
# --
\\vec{$1}$0

# name: tilde
# key: tilde
# condition: (texmathp)
# --
\\tilde{$1}$0

# name: dot
# key: dot
# condition: (texmathp)
# --
\\dot{$1}$0

# name: ddot
# key: ddot
# condition: (texmathp)
# --
\\ddot{$1}$0

# name: underline
# key: und
# condition: (texmathp)
# --
\\underline{$1}$0

# name: overline
# key: ovl
# condition: (texmathp)
# --
\\overline{$1}$0

# name: not-equal
# key: ne
# condition: (texmathp)
# --
\\neq $0

# name: leq
# key: leq
# condition: (texmathp)
# --
\\leq $0

# name: geq
# key: geq
# condition: (texmathp)
# --
\\geq $0

# name: approx
# key: apx
# condition: (texmathp)
# --
\\approx $0

# name: sum-from-to
# key: sum
# condition: (texmathp)
# --
\\sum_{$1}^{$2} $0

# name: integral-from-to
# key: int
# condition: (texmathp)
# --
\\int_{$1}^{$2} $0

# name: limit
# key: lim
# condition: (texmathp)
# --
\\lim_{$1} $0

# name: arrow-right
# key: rarr
# condition: (texmathp)
# --
\\rightarrow $0

# name: arrow-left
# key: larr
# condition: (texmathp)
# --
\\leftarrow $0

# name: arrow-leftright
# key: lrar
# condition: (texmathp)
# --
\\leftrightarrow $0
