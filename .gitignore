# Generated Org-export artifact (regenerated by tangle on every publish).

# Nix build artifacts
result
result-*
*.drv
/.gitignore
/diag-igloo.svg

# Emacs byte-compile / package.el artifacts
emacs/**/*.elc
emacs/elpa/

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
/.claude/
/.windsurf/
/.github/
/.cursor/
/.clinerules/

# doom modules reference checkout (git clone, not committed)
emacs/doom-modules/

# caelestia shell reference checkout (git clone, not committed)
/caelestia/

# Emacs runtime state (never committed)
emacs/#*#
emacs/.#*

# Hyprland runtime-generated scheme (entrypoint copies scheme/default.lua here)
modules/community/lix/core/hyprland/config/scheme/current.lua

# Emacs runtime state (all under emacs/.cache — never committed)
emacs/.cache/

# Emacs runtime state leftovers (older runs; never re-commit)
emacs/.local/
emacs/projectile-*.eld
emacs/project/
emacs/undo-fu-session/
emacs/workspaces*
emacs/auto-save-list/
emacs/url/

# session memory (not project code)
session-emacs-config.md*
emacs/tramp
