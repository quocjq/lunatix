# -*- mode: snippet -*-
# name: left-paren
# key: lr(
# condition: (texmathp)
# --
\\left( $1 \\right)$0

# name: left-bracket
# key: lr[
# condition: (texmathp)
# --
\\left[ $1 \\right]$0

# name: left-brace
# key: lr{
# condition: (texmathp)
# --
\\left\\{ $1 \\right\\}$0

# name: left-bar
# key: lr|
# condition: (texmathp)
# --
\\left| $1 \\right|$0

# name: left-angle
# key: lr<
# condition: (texmathp)
# --
\\left\\langle $1 \\right\\rangle$0

# name: left-ceiling
# key: lrc
# condition: (texmathp)
# --
\\left\\lceil $1 \\right\\rceil$0

# name: left-floor
# key: lrf
# condition: (texmathp)
# --
\\left\\lfloor $1 \\right\\rfloor$0

# name: left-double-bar
# key: lr||
# condition: (texmathp)
# --
\\left\\| $1 \\right\\|$0
