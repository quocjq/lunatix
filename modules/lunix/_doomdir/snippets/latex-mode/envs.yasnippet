# -*- mode: snippet -*-
# name: matrix
# key: mat
# condition: (texmathp)
# --
\\begin{matrix}
$1 & $2 \\\\
$3 & $4
\\end{matrix}$0

# name: pmatrix
# key: pmat
# condition: (texmathp)
# --
\\begin{pmatrix}
$1 & $2 \\\\
$3 & $4
\\end{pmatrix}$0

# name: bmatrix
# key: bmat
# condition: (texmathp)
# --
\\begin{bmatrix}
$1 & $2 \\\\
$3 & $4
\\end{bmatrix}$0

# name: vmatrix
# key: vmat
